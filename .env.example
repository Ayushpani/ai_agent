# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Doc §9.3: obtain data-retention/use-in-training confirmation from both
# providers, and client DPDP/InfoSec sign-off, before pointing this at
# production data. Use synthetic data (ingestion/synthetic_data.py) until then.

# --- Free-tier LLM providers (doc §4, §6.2) ---
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- PII masking (doc §5.1 stage [3]) ---
# HMAC secret for deterministic customer/UCID hashing. Rotate via a
# proper key-management flow in production (AWS SSM); a local-only
# throwaway value is fine for the POC.
PII_HASH_SECRET=change-me-before-any-real-data

# --- Observability (doc §4, §10.1) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-intelligence-agent

# --- Storage (doc §5.3) ---
# Leave unset for POC (local /data/curated). Set for the Phase 2 S3 path.
AWS_REGION=
S3_CURATED_BUCKET=
