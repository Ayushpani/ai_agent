# Copy to .env and fill in. Never commit the real .env (see .gitignore).
# Doc §9.3: obtain data-retention/use-in-training confirmation from both
# providers, and client DPDP/InfoSec sign-off, before pointing this at
# production data. Use synthetic data (ingestion/synthetic_data.py) until then.

# --- Free-tier LLM providers (doc §4, §6.2) ---
OPENROUTER_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# --- Per-stage model overrides (app/graph/model_router.py) ---
# OpenRouter's free-model catalog rotates on a timescale of weeks, so
# the hardcoded defaults WILL eventually 404. If you see
# "AllProvidersExhaustedError" or a "model not found / use this slug
# instead" error, fix it here rather than editing code:
#
#   1. Go to https://openrouter.ai/models, filter to Free.
#   2. Open a model and copy the exact slug shown in its API code
#      sample (e.g. "meta-llama/llama-3.3-70b-instruct:free") — the
#      human-readable name shown in the UI ("Meta: Llama 3.3 70B
#      (free)") is NOT the slug and will not work.
#   3. Paste it below as-is. The bare OpenRouter slug (no "openrouter/"
#      prefix) is auto-normalized — you don't need to add the prefix
#      yourself, though it's harmless if you do. Comma-separate
#      multiple slugs for a fallback chain (first = primary).
#
# Leave unset to use the built-in defaults.
# ROUTER_MODELS=meta-llama/llama-3.2-3b-instruct:free
# SQL_GENERATOR_MODELS=qwen/qwen-2.5-coder-32b-instruct:free
# ANALYST_MODELS=meta-llama/llama-3.3-70b-instruct:free
# NARRATOR_MODELS=mistralai/mistral-7b-instruct:free

# --- PII masking (doc §5.1 stage [3]) ---
# HMAC secret for deterministic customer/UCID hashing. Rotate via a
# proper key-management flow in production (AWS SSM); a local-only
# throwaway value is fine for the POC.
PII_HASH_SECRET=change-me-before-any-real-data

# --- Observability (doc §4, §10.1) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=portfolio-intelligence-agent

# --- Storage (doc §5.3) ---
# Leave unset for POC (local /data/curated). Set for the Phase 2 S3 path.
AWS_REGION=
S3_CURATED_BUCKET=
